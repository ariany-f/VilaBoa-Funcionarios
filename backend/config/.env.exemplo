# Copie para backend/config/.env (não versionado) ou defina como variáveis de ambiente do servidor.

# --- Conexões de banco -------------------------------------------------------
# Nomes das conexões (a primeira é a padrão; "principal" usa o prefixo DB_, as demais DB_<NOME>_)
DB_CONEXOES=principal
#DB_PADRAO=principal

# Conexão principal: pgsql | mysql | sqlsrv | sqlite | json (simulação em arquivos)
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portal_funcionarios
DB_USERNAME=portal_funcionarios_app
DB_PASSWORD=troque-esta-senha

# Exemplo de uma segunda conexão, de outra arquitetura (ex.: SQL Server), usada com Banco::conexao('legado'):
#DB_CONEXOES=principal,legado
#DB_LEGADO_DRIVER=sqlsrv
#DB_LEGADO_HOST=10.0.0.20
#DB_LEGADO_PORT=1433
#DB_LEGADO_DATABASE=ERP
#DB_LEGADO_USERNAME=leitura
#DB_LEGADO_PASSWORD=

# --- Só para instalar/criar o banco (php backend/scripts/instalar_banco.php) -----
# Usuário com permissão de criar banco e usuário no servidor. Remova depois da instalação.
#DB_ADMIN_USERNAME=postgres
#DB_ADMIN_PASSWORD=
